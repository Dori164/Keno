<Window x:Class="KenoGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KenoGUI - Szelvénykezelő"
        Height="500"
        Width="700">


    <Grid>
        <!-- Fő elrendezés: Bal oldali lista, jobb oldali rács -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Gombok -->
        <StackPanel Grid.ColumnSpan="2" Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button x:Name="btnBetolt" Content="Szelvények betöltése" Width="120" Margin="5" Click="BtnBetolt_Click"/>
            <Button x:Name="btnSorsol" Content="Napi sorsolás" Width="110" Margin="5" Click="BtnSorsol_Click"/>
        </StackPanel>

        <!-- Bal oldali lista: Szelvények -->
        <GroupBox Grid.Column="0" Grid.Row="1" Header="Szelvények" Margin="5">
            <ListBox x:Name="lstSzelvenyek" SelectionChanged="LstSzelvenyek_SelectionChanged"/>
        </GroupBox>

        <!-- Jobb oldali rács: Számok 1-80 -->
        <GroupBox Grid.Column="1" Grid.Row="1" Header="Szelvény" Margin="5">
            <Grid x:Name="gridSzelveny" Background="LightGreen">
                <!-- 8 sor, 10 oszlop -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </GroupBox>

        <!-- Szorzó és nyeremény -->
        <StackPanel Grid.ColumnSpan="2" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Label x:Name="lblSzorzo" Content="Szorzó: " FontWeight="Bold" Margin="5"/>
            <Label x:Name="lblNyeremeny" Content="Nyeremény: " FontWeight="Bold" Foreground="Red" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
